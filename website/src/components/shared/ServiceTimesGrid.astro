---
import type { ServiceTime } from "../../lib/api";

interface Props {
  services: ServiceTime[];
  variant?: "cards" | "compact";
  /** Number of columns on desktop (default: auto-fit with minmax). */
  columns?: 1 | 2 | 3 | 4;
  /** Minimum card width before grid wraps. */
  minCardWidth?: string;
}

const { services, variant = "cards", columns, minCardWidth = "280px" } = Astro.props;

// Build grid template based on columns preference
const gridTemplate = columns
  ? `repeat(${columns}, 1fr)`
  : `repeat(auto-fit, minmax(${minCardWidth}, 1fr))`;
---

{
  variant === "compact" ? (
    <div class="flex flex-wrap gap-4">
      {services.map((service) => (
        <div class="glass-frost rounded-xl px-5 py-3">
          <p class="text-xs font-semibold uppercase tracking-wider text-primary">
            {service.day}
          </p>
          <p class="font-semibold text-foreground">{service.name}</p>
          <p class="text-sm text-muted-foreground">{service.time}</p>
        </div>
      ))}
    </div>
  ) : (
    <div
      class="grid gap-6 md:gap-8"
      style={`grid-template-columns: ${gridTemplate};`}
    >
      {services.map((service) => (
        <article class="card-hover overflow-hidden rounded-xl glass-frost">
          {service.image && (
            <div class="relative aspect-[16/6] w-full">
              <img
                src={service.image}
                alt={service.name}
                class="h-full w-full object-cover"
              />
            </div>
          )}
          <div class="border-t border-border p-4">
            <div class="mb-4 flex items-start justify-between">
              <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-primary">
                  {service.day} · {service.time}
                </p>
                <h3 class="mt-1 font-display text-xl text-foreground">
                  {service.name}
                </h3>
              </div>
              {service.platform === "online" ? (
                <span class="text-primary" aria-label="Online service">🖥️</span>
              ) : (
                <span class="text-primary" aria-label="Physical service">📍</span>
              )}
            </div>
            {service.location && (
              <p class="text-sm font-medium text-foreground">
                {service.location}
              </p>
            )}
            {service.description && (
              <p class="mt-2 text-sm text-muted-foreground">
                {service.description}
              </p>
            )}
            {service.link && (
              <a
                href={service.link}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-block text-sm font-semibold text-primary transition-colors hover:text-gold-600"
              >
                Join Online →
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  )
}