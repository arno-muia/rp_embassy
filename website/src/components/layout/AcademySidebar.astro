---
import { site } from "../../lib/site";
const currentPath = Astro.url.pathname;
---

<aside
  id="academy-sidebar"
  class="fixed top-[5.5rem] left-0 z-40 hidden h-[calc(100vh-5.5rem)] w-64 transform -translate-x-full border-r border-border bg-background transition-transform duration-300 lg:translate-x-0 lg:fixed lg:block"
>
  <div class="flex h-full flex-col">
    <div class="border-b border-border p-4 lg:hidden">
      <a href="/" class="flex shrink-0 items-center justify-center">
        <img
          src="/rp-logo.svg"
          alt={site.name}
          width="140"
          height="36"
          class="h-9 w-auto brightness-0 invert"
        />
      </a>
    </div>

    <nav class="flex-1 overflow-y-auto px-3 py-4" aria-label="Academy">
      <ul class="space-y-1">
        <li>
          <a
            href="/academy"
            class={`flex items-center gap-3 rounded-lg px-3 py-2.5 text-base font-semibold transition-colors ${
              currentPath === "/academy"
                ? "bg-primary/10 text-primary"
                : "text-muted-foreground hover:bg-muted hover:text-primary"
            }`}
          >
            <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            <span class="truncate">Dashboard</span>
          </a>
        </li>

        <li>
          <a
            href="/academy/performance"
            class={`flex items-center gap-3 rounded-lg px-3 py-2.5 text-base font-semibold transition-colors ${
              currentPath.startsWith("/academy/performance")
                ? "bg-primary/10 text-primary"
                : "text-muted-foreground hover:bg-muted hover:text-primary"
            }`}
          >
            <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            <span class="truncate">Performance</span>
          </a>
        </li>

        <li>
          <button
            type="button"
            class="sidebar-dropdown-toggle flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-base font-semibold text-muted-foreground transition-colors hover:bg-muted hover:text-primary"
            aria-expanded="false"
            data-dropdown="resources"
          >
            <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
            </svg>
            <span class="truncate">Resources</span>
            <svg class="ml-auto h-4 w-4 shrink-0 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <ul class="sidebar-dropdown hidden mt-1 space-y-1 pl-10" data-dropdown-content="resources">
            <li>
              <a href="/academy/resources/audios" class={`flex items-center gap-2 rounded-md px-3 py-2 text-sm transition-colors ${currentPath.startsWith("/academy/resources/audios") ? "bg-primary/10 text-primary" : "text-muted-foreground hover:text-primary"}`}>
                <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
                </svg>
                Audios
              </a>
            </li>
            <li>
              <a href="/academy/resources/pdfs" class={`flex items-center gap-2 rounded-md px-3 py-2 text-sm transition-colors ${currentPath.startsWith("/academy/resources/pdfs") ? "bg-primary/10 text-primary" : "text-muted-foreground hover:text-primary"}`}>
                <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                </svg>
                PDFs
              </a>
            </li>
            <li>
              <a href="/academy/resources/flashcards" class={`flex items-center gap-2 rounded-md px-3 py-2 text-sm transition-colors ${currentPath.startsWith("/academy/resources/flashcards") ? "bg-primary/10 text-primary" : "text-muted-foreground hover:text-primary"}`}>
                <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
                Flashcards
              </a>
            </li>
            <li>
              <a href="/academy/resources/study-tips" class={`flex items-center gap-2 rounded-md px-3 py-2 text-sm transition-colors ${currentPath.startsWith("/academy/resources/study-tips") ? "bg-primary/10 text-primary" : "text-muted-foreground hover:text-primary"}`}>
                <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m12.728 0l-.707.707M12 21a9 9 0 110-18 9 9 0 010 18z" />
                </svg>
                Study Tips
              </a>
            </li>
          </ul>
        </li>

        <li>
          <a
            href="/academy/feedback"
            class={`flex items-center gap-3 rounded-lg px-3 py-2.5 text-base font-semibold transition-colors ${
              currentPath.startsWith("/academy/feedback")
                ? "bg-primary/10 text-primary"
                : "text-muted-foreground hover:bg-muted hover:text-primary"
            }`}
          >
            <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
            </svg>
            <span class="truncate">Help Center</span>
          </a>
        </li>

        <li>
          <button
            type="button"
            class="sidebar-dropdown-toggle flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-base font-semibold text-muted-foreground transition-colors hover:bg-muted hover:text-primary"
            aria-expanded="false"
            data-dropdown="evaluation"
          >
            <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
            </svg>
            <span class="truncate">Evaluation</span>
            <svg class="ml-auto h-4 w-4 shrink-0 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <ul class="sidebar-dropdown hidden mt-1 space-y-1 pl-10" data-dropdown-content="evaluation">
            <li>
              <a href="/academy/evaluation/quizzes" class={`flex items-center gap-2 rounded-md px-3 py-2 text-sm transition-colors ${currentPath.startsWith("/academy/evaluation/quizzes") ? "bg-primary/10 text-primary" : "text-muted-foreground hover:text-primary"}`}>
                <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                Quizzes
              </a>
            </li>
            <li>
              <a href="/academy/evaluation/tests" class={`flex items-center gap-2 rounded-md px-3 py-2 text-sm transition-colors ${currentPath.startsWith("/academy/evaluation/tests") ? "bg-primary/10 text-primary" : "text-muted-foreground hover:text-primary"}`}>
                <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                </svg>
                Tests
              </a>
            </li>
          </ul>
        </li>

        <li>
          <a
            href="/academy/help"
            class={`flex items-center gap-3 rounded-lg px-3 py-2.5 text-base font-semibold transition-colors ${
              currentPath.startsWith("/academy/help")
                ? "bg-primary/10 text-primary"
                : "text-muted-foreground hover:bg-muted hover:text-primary"
            }`}
          >
            <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="truncate">Help Center</span>
          </a>
        </li>
      </ul>
    </nav>

    <div class="border-t border-border p-3">
      <p class="px-3 py-2 text-xs text-muted-foreground">©2026 Royal Priesthood Embassy</p>
    </div>
  </div>
</aside>

<script>
  function initSidebar() {
    const sidebar = document.getElementById("academy-sidebar");
    const toggle = document.getElementById("sidebar-toggle");
    const dropdownToggles = document.querySelectorAll(".sidebar-dropdown-toggle");

    function openSidebar() {
      sidebar?.classList.remove("-translate-x-full");
      document.body.style.overflow = "hidden";
    }

    function closeSidebar() {
      sidebar?.classList.add("-translate-x-full");
      document.body.style.overflow = "";
    }

    toggle?.addEventListener("click", () => {
      if (sidebar?.classList.contains("-translate-x-full")) {
        openSidebar();
      } else {
        closeSidebar();
      }
    });

    dropdownToggles.forEach((btn) => {
      btn.addEventListener("click", () => {
        const dropdownId = btn.getAttribute("data-dropdown");
        const content = document.querySelector(`[data-dropdown-content="${dropdownId}"]`);
        const icon = btn.querySelector("svg:last-child");
        const isExpanded = btn.getAttribute("aria-expanded") === "true";

        if (isExpanded) {
          content?.classList.add("hidden");
          icon?.classList.remove("rotate-180");
          btn.setAttribute("aria-expanded", "false");
        } else {
          content?.classList.remove("hidden");
          icon?.classList.add("rotate-180");
          btn.setAttribute("aria-expanded", "true");
        }
      });
    });

    document.addEventListener("click", (e) => {
      if (!sidebar?.contains(e.target as Node) && !toggle?.contains(e.target as Node)) {
        closeSidebar();
      }
    });
  }

  if (typeof window !== "undefined") {
    initSidebar();
  }
</script>