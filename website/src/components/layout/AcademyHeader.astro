---
import { site } from "../../lib/site";
import { API_ENDPOINTS, getMe } from "../../lib/api";
import { getCsrfToken, logout } from "../../lib/auth";

// A1: Forward the browser's Cookie header for auth check
const cookieHeader = Astro.request.headers.get("cookie") || undefined;
const user = await getMe(cookieHeader);
const isAuthenticated = !!user;
---

<header
  id="academy-header"
  class="fixed inset-x-0 top-0 z-50 bg-gold-500 transition-[background-color,box-shadow] duration-300"
>
  <div
    class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-4 md:px-8"
  >
    <a
      href="/"
      class="flex shrink-0 items-center transition-transform duration-200 hover:scale-[1.02]"
    >
      <img
        src="/rp-logo.svg"
        alt={site.name}
        width="180"
        height="48"
        class="h-10 w-auto md:h-11 brightness-0 invert"
      />
    </a>

    <div class="flex items-center gap-3">
      <button
        type="button"
        id="sidebar-toggle"
        class="flex h-10 w-10 items-center justify-center rounded-full border border-white/30 text-white transition-colors hover:bg-white/10 lg:hidden"
        aria-label="Open sidebar menu"
      >
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      {isAuthenticated && (
        <div class="relative">
          <button
            type="button"
            id="profile-toggle"
            aria-expanded="false"
            aria-label="Open profile menu"
            class="group flex h-11 w-11 items-center justify-center rounded-full border border-white/30 bg-white/10 text-white transition-all hover:bg-white/20"
          >
            <svg
              class="h-6 w-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
              />
            </svg>
          </button>

          <div
            id="profile-dropdown"
            class="absolute right-0 top-full mt-2 hidden w-56 rounded-xl border border-border bg-background shadow-gold-lg overflow-hidden"
          >
            <div class="px-4 py-3 border-b border-border">
              <p class="text-sm font-medium text-foreground">
                {user?.name ?? "User"}
              </p>
              <p class="text-xs text-muted-foreground truncate">
                {user?.email}
              </p>
            </div>
            <nav class="py-1" aria-label="Profile menu">
              <a
                href="/change-password"
                class="flex items-center gap-3 px-4 py-2 text-sm text-foreground transition-colors hover:bg-muted hover:text-primary"
              >
                <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                My Profile
              </a>
              <a
                href="/change-password"
                class="flex items-center gap-3 px-4 py-2 text-sm text-foreground transition-colors hover:bg-muted hover:text-primary"
              >
                <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                Settings
              </a>
              <div class="border-t border-border my-1"></div>
              <button
                type="button"
                id="theme-toggle-academy"
                class="flex w-full items-center gap-3 px-4 py-2 text-sm text-foreground transition-colors hover:bg-muted hover:text-primary"
              >
                <span id="sun-icon-academy" class="hidden">
                  <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12h-1m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0z" />
                  </svg>
                </span>
                <span id="moon-icon-academy">
                  <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
                  </svg>
                </span>
                <span id="theme-label-academy">Dark Theme</span>
              </button>
              <div class="border-t border-border my-1"></div>
              <button
                type="button"
                id="signout-btn-academy"
                class="flex w-full items-center gap-3 px-4 py-2 text-sm text-rp-danger transition-colors hover:bg-rp-danger/10"
              >
                <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                </svg>
                Log Out
              </button>
            </nav>
          </div>
        </div>
      )}
    </div>
  </div>
</header>

<script>
  import { API_ENDPOINTS } from "../../lib/api";
  import { getCsrfToken } from "../../lib/auth";

  const profileToggle = document.getElementById("profile-toggle");
  const dropdown = document.getElementById("profile-dropdown");
  let dropdownOpen = false;

  function openDropdown() {
    dropdownOpen = true;
    dropdown?.classList.remove("hidden");
    profileToggle?.setAttribute("aria-expanded", "true");
    profileToggle?.setAttribute("aria-label", "Close profile menu");
  }

  function closeDropdown() {
    dropdownOpen = false;
    dropdown?.classList.add("hidden");
    profileToggle?.setAttribute("aria-expanded", "false");
    profileToggle?.setAttribute("aria-label", "Open profile menu");
  }

  profileToggle?.addEventListener("click", (e) => {
    e.stopPropagation();
    dropdownOpen ? closeDropdown() : openDropdown();
  });

  document.addEventListener("click", (e) => {
    if (dropdownOpen && !dropdown?.contains(e.target)) {
      closeDropdown();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && dropdownOpen) {
      closeDropdown();
      profileToggle?.focus();
    }
  });

  // Logout handler
  async function handleSignOut() {
    try {
      const csrfToken = await getCsrfToken();
      await fetch(API_ENDPOINTS.logout, {
        method: "POST",
        credentials: "include",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
          ...(csrfToken ? { "X-CSRFToken": csrfToken } : {}),
        },
      });
    } catch {
      // ignore — redirect anyway
    }
    window.location.href = "/login?redirect=/academy";
  }

  // Theme toggle handler
  const themeToggleAcademy = document.getElementById("theme-toggle-academy");
  const sunIconAcademy = document.getElementById("sun-icon-academy");
  const moonIconAcademy = document.getElementById("moon-icon-academy");
  const themeLabelAcademy = document.getElementById("theme-label-academy");
  const html = document.documentElement;

  function updateThemeUI(theme) {
    if (theme === "dark") {
      // Currently dark → offer Light Theme with sun icon
      sunIconAcademy?.classList.remove("hidden");
      moonIconAcademy?.classList.add("hidden");
      if (themeLabelAcademy) themeLabelAcademy.textContent = "Light Theme";
    } else {
      // Currently light → offer Dark Theme with moon icon
      sunIconAcademy?.classList.add("hidden");
      moonIconAcademy?.classList.remove("hidden");
      if (themeLabelAcademy) themeLabelAcademy.textContent = "Dark Theme";
    }
  }

  // Initialize theme UI
  const savedTheme = localStorage.getItem("rp-theme") || "light";
  updateThemeUI(savedTheme);

  themeToggleAcademy?.addEventListener("click", () => {
    const currentTheme = html.getAttribute("data-theme");
    const newTheme = currentTheme === "dark" ? "light" : "dark";

    html.setAttribute("data-theme", newTheme);
    localStorage.setItem("rp-theme", newTheme);
    updateThemeUI(newTheme);
  });

  document.getElementById("signout-btn-academy")?.addEventListener("click", handleSignOut);
</script>