---
import { API_ENDPOINTS } from "../../lib/api";

const inputClass =
  "w-full rounded-md border border-border bg-card px-4 py-3 text-sm text-foreground transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/15";
---

<form id="login-form" class="space-y-5" data-endpoint={API_ENDPOINTS.login}>
  <p
    data-error
    class="hidden rounded-md border border-rp-danger/30 bg-rp-danger/5 px-4 py-3 text-sm text-rp-danger"
    role="alert"
  ></p>
  <div class="space-y-2">
    <label for="email" class="text-sm font-medium text-foreground">Email</label>
    <input
      id="email"
      name="email"
      type="email"
      autocomplete="email"
      required
      placeholder="you@example.com"
      class={inputClass}
    />
  </div>
  <div class="space-y-2">
    <label for="password" class="text-sm font-medium text-foreground">
      Password
    </label>
    <input
      id="password"
      name="password"
      type="password"
      autocomplete="current-password"
      required
      minlength="8"
      placeholder="••••••••"
      class={inputClass}
    />
  </div>
  <button
    type="submit"
    class="btn-primary-gold w-full rounded-md px-6 py-3 text-sm font-semibold text-white"
  >
    Sign In
  </button>
</form>

<script>
  const form = document.getElementById("login-form") as HTMLFormElement | null;
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const err = form.querySelector("[data-error]") as HTMLElement;
    err.className =
      "hidden rounded-md border border-rp-danger/30 bg-rp-danger/5 px-4 py-3 text-sm text-rp-danger";
    const data = Object.fromEntries(new FormData(form));
    const btn = form.querySelector("button[type=submit]") as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = "Signing in…";
    try {
      const res = await fetch(form.dataset.endpoint!, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          email: String(data.email).toLowerCase().trim(),
          password: data.password,
        }),
      });
      const body = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(body.error ?? "Invalid email or password.");
      window.location.href = "/dashboard";
    } catch (e) {
      err.textContent =
        e instanceof Error ? e.message : "Something went wrong.";
      err.className =
        "rounded-md border border-rp-danger/30 bg-rp-danger/5 px-4 py-3 text-sm text-rp-danger";
      btn.disabled = false;
      btn.textContent = "Sign In";
    }
  });
</script>