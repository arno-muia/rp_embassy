---
import { API_ENDPOINTS } from "../../lib/api";

const formShellClass = "space-y-6 glass-frost rounded-2xl p-8";
const labelClass = "block text-sm font-medium text-foreground";
const inputClass =
  "mt-1 w-full rounded-md border border-border bg-card px-4 py-3 text-sm text-foreground transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/15";
---

<div id="change-password-container" data-endpoint={API_ENDPOINTS.changePassword}>
  <form id="change-password-form-element" class={formShellClass}>
    <h1 class="font-display text-2xl text-foreground">Change Password</h1>
    <p class="text-sm text-muted-foreground">
      You must set a new password before continuing.
    </p>
    <p
      data-error
      class="hidden text-sm text-rp-danger"
      role="alert"
    ></p>
    <div class="space-y-4">
      <div class="space-y-2">
        <label for="currentPassword" class={labelClass}>Current password *</label>
        <input
          id="currentPassword"
          name="currentPassword"
          type="password"
          required
          minlength="8"
          class={inputClass}
        />
      </div>
      <div class="space-y-2">
        <label for="newPassword" class={labelClass}>New password *</label>
        <input
          id="newPassword"
          name="newPassword"
          type="password"
          required
          minlength="8"
          class={inputClass}
        />
      </div>
      <div class="space-y-2">
        <label for="confirmPassword" class={labelClass}>Confirm new password *</label>
        <input
          id="confirmPassword"
          name="confirmPassword"
          type="password"
          required
          minlength="8"
          class={inputClass}
        />
      </div>
    </div>
    <button
      type="submit"
      class="btn-primary-gold mt-6 w-full rounded-md px-6 py-3 text-sm font-semibold text-white"
    >
      Update Password
    </button>
  </form>
  
  <div id="success-state" class="hidden text-center">
    <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-rp-success/10 text-rp-success">
      ✓
    </div>
    <h2 class="font-display mt-4 text-2xl text-foreground">Password updated!</h2>
    <p class="mt-2 text-muted-foreground">Redirecting to dashboard...</p>
  </div>
</div>

<script>
  const container = document.getElementById("change-password-container");
  const form = document.getElementById("change-password-form-element") as HTMLFormElement | null;
  const successState = document.getElementById("success-state") as HTMLElement | null;
  
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const err = form.querySelector("[data-error]") as HTMLElement;
    err.className = "hidden text-sm text-rp-danger";
    const data = Object.fromEntries(new FormData(form));
    const newPassword = String(data.newPassword);
    const confirmPassword = String(data.confirmPassword);
    
    if (newPassword !== confirmPassword) {
      err.textContent = "Passwords do not match.";
      err.className = "text-sm text-rp-danger";
      return;
    }
    
    const btn = form.querySelector("button[type=submit]") as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = "Updating…";
    
    try {
      const res = await fetch((container as HTMLElement).dataset.endpoint!, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          currentPassword: data.currentPassword,
          newPassword,
        }),
      });
      const body = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(body.error ?? "Failed to change password");
      
      form.classList.add("hidden");
      successState?.classList.remove("hidden");
      setTimeout(() => (window.location.href = "/dashboard"), 1500);
    } catch (errMsg) {
      const errorText = errMsg instanceof Error ? errMsg.message : "Something went wrong.";
      err.textContent = errorText;
      err.className = "text-sm text-rp-danger";
      btn.disabled = false;
      btn.textContent = "Update Password";
    }
  });
</script>