---
import type { AcademyModuleView } from "../../types";

interface Props {
  module: AcademyModuleView;
}

const { module } = Astro.props;
---

<article class="card-hover glass-frost rounded-xl p-6">
  <span class="text-xs font-semibold uppercase tracking-wider text-primary">
    Module {module.order}
  </span>
  <h3 class="mt-2 font-display text-xl text-foreground">{module.title}</h3>
  <p class="mt-2 text-sm text-muted-foreground">{module.description}</p>
  <div
    class="mt-4 flex items-center justify-between text-xs text-muted-foreground"
  >
    <span>{module.instructor}</span>
    <span>{module.lessonsCount} lessons · {module.duration}</span>
  </div>
</article>