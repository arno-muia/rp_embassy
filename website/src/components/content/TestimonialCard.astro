---
import type { TestimonialView } from "../../types";

interface Props {
  testimonial: TestimonialView;
}

const { testimonial } = Astro.props;
const photoSrc = testimonial.photo;
---

<div class="glass-frost rounded-2xl p-8 text-center md:p-12">
  <blockquote class="text-lg leading-relaxed text-foreground md:text-xl">
    &ldquo;{testimonial.quote}&rdquo;
  </blockquote>
  <footer class="mt-6">
    {
      photoSrc && (
        <div class="mx-auto mb-3 h-20 w-20 overflow-hidden rounded-full border-2 border-primary/30">
          <img
            src={photoSrc}
            alt={testimonial.name}
            class="h-full w-full object-cover"
          />
        </div>
      )
    }
    <p class="font-semibold text-primary">{testimonial.name}</p>
    {testimonial.role && (
      <p class="text-sm text-muted-foreground">{testimonial.role}</p>
    )}
  </footer>
</div>