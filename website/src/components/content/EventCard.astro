---
import type { EventView } from "../../types";
import { formatEventDate } from "../../lib/format";

interface Props {
  event: EventView;
}

const { event } = Astro.props;

const monthAbbr = new Date(event.date).toLocaleDateString("en-US", { month: "short" }).toUpperCase();
const dayNum = new Date(event.date).getDate();

const displayTime = event.endTime
  ? `${event.time} – ${event.endTime}`
  : event.time;
---

<article class="group card-hover">
  <a href={`/events/${event.id}`} class="block">
    <div class="relative aspect-[4/3] overflow-hidden rounded-xl">
      <img
        src={event.image}
        alt={`${event.title} — ${event.categoryLabel} event banner`}
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
      <!-- Category badge -->
      <span
        class="absolute left-3 top-3 rounded-full bg-obsidian-900/70 px-3 py-1 text-xs font-semibold text-ivory-25 backdrop-blur-sm"
      >
        {event.categoryLabel}
      </span>
      <!-- Calendar chip -->
      <div
        class="absolute bottom-3 right-3 flex flex-col items-center rounded-lg bg-white/90 px-3 py-1.5 text-center shadow-md backdrop-blur-sm dark:bg-obsidian-800/90"
      >
        <span class="text-xs font-bold uppercase tracking-wide text-gold-600 dark:text-gold-400">
          {monthAbbr}
        </span>
        <span class="-mt-0.5 text-xl font-bold leading-none text-obsidian-900 dark:text-ivory-25">
          {dayNum}
        </span>
      </div>
      {
        event.status === "ongoing" && (
          <span class="absolute left-3 bottom-3 rounded-full bg-fire-500 px-3 py-1 text-xs font-semibold text-white">
            Ongoing
          </span>
        )
      }
    </div>
    <div class="mt-5 space-y-2">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted-foreground">
        <!-- Date -->
        <span class="inline-flex items-center gap-1">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>{formatEventDate(event.date)}</span>
        </span>
        <!-- Time -->
        <span class="inline-flex items-center gap-1">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{displayTime}</span>
        </span>
        <!-- Location -->
        <span class="inline-flex items-center gap-1">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>{event.location}</span>
        </span>
      </div>
      <h3 class="font-display text-xl text-foreground group-hover:text-primary">
        {event.title}
      </h3>
    </div>
  </a>
</article>