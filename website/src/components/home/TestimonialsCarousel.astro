---
interface Props {
  testimonials: Array<{
    id: string;
    quote: string;
    name: string;
    role?: string;
    photo?: string;
  }>;
  sermonThumbnail?: string;
}

const { testimonials = [], sermonThumbnail = "" }: Props = Astro.props;
---

<section class="register-celestial section-padding" style="padding-bottom: 2rem;">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="mb-12 text-center" data-reveal data-reveal-y="24" data-reveal-duration="0.5">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Real Stories</p>
      <h2 class="font-display mt-2 text-3xl text-foreground md:text-4xl">Testimonies</h2>
    </div>

    <div class="grid grid-cols-1 gap-6 md:gap-8">
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:gap-8 lg:grid-cols-3 lg:justify-items-center">
        {testimonials.map((testimonial) => (
          <div class="flex flex-col border border-border rounded-2xl bg-card shadow-sm">
            <div class="flex flex-1 flex-col justify-center p-6 md:p-8">
              <div>
                <h3 class="mb-3 text-xl font-bold text-foreground md:text-2xl text-center">
                  {testimonial.name}
                </h3>
                <p class="text-sm text-muted-foreground line-clamp-3">"{testimonial.quote}"</p>
                {testimonial.role && (
                  <p class="mt-2 text-xs text-primary text-center">{testimonial.role}</p>
                )}
              </div>
            </div>
            <div class="flex items-center justify-center p-6">
              <div class="h-32 w-32 overflow-hidden rounded-full border-4 border-primary/20">
                <img
                  src={testimonial.photo || `/images/${testimonial.name.split(' ')[0].toLowerCase()}.jpg`}
                  alt={testimonial.name}
                  class="h-full w-full object-cover"
                />
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>