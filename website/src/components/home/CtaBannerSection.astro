---
import Button from "../ui/Button.astro";
import type { ServiceTime } from "../../lib/api";
import type { EventView } from "../../types";
import { formatDayOfWeek } from "../../lib/format";

interface Props {
  serviceTimes?: ServiceTime[];
  hero?: {
    cta_heading?: string;
    cta_title?: string;
    cta_description?: string;
    cta_button_text?: string;
    cta_button_url?: string;
    cta_secondary_button_text?: string;
    cta_secondary_button_url?: string;
    cta_location?: string;
  };
  /** Next upcoming meeting (event) — drives the day/time/venue when present. */
  upcomingEvent?: EventView;
}

const { serviceTimes, hero, upcomingEvent } = Astro.props;

const firstService = serviceTimes?.[0];

// Day / time / venue are driven by the upcoming meeting (event) when available,
// falling back to the regular service times. Admin-managed hero text is always
// respected as an override — only the model-default strings are replaced by the
// event-derived value (see DEFAULT_* constants below).
const DEFAULT_HEADING = "Join Us This Sunday";
const DEFAULT_LOCATION = "Thika, Kenya";

const upNextDay = upcomingEvent ? formatDayOfWeek(upcomingEvent.date) : null;
const upNextDayUpper = upNextDay ? upNextDay.toUpperCase() : null;

const heading =
  (hero?.cta_heading && hero.cta_heading !== DEFAULT_HEADING)
    ? hero.cta_heading
    : upNextDayUpper
      ? `JOIN US THIS ${upNextDayUpper}`
      : hero?.cta_heading || DEFAULT_HEADING;

const venue =
  (hero?.cta_location && hero.cta_location !== DEFAULT_LOCATION)
    ? hero.cta_location
    : upcomingEvent?.location || hero?.cta_location || DEFAULT_LOCATION;

const title = hero?.cta_title || "You're Invited";
const description = hero?.cta_description || "Whether you are exploring faith, looking for a church home, or have walked with Jesus for years — we have a place for you in Thika.";
const buttonText = hero?.cta_button_text || "Plan Your Visit";
const buttonUrl = hero?.cta_button_url || "/visit";
const secondaryButtonText = hero?.cta_secondary_button_text || "Watch a Sermon";
const secondaryButtonUrl = hero?.cta_secondary_button_url || "/sermons";
---

<section class="section-padding">
  <div data-reveal data-reveal-y="24" data-reveal-duration="0.5"
    class="glass-frost mx-auto max-w-7xl rounded-2xl px-5 py-16 text-center md:px-8"
  >
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">
      {heading}
    </p>
    <h2 class="font-display mt-4 text-3xl text-foreground md:text-5xl">
      {title}
    </h2>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-muted-foreground">
      {description}
    </p>
    {
      (upcomingEvent || firstService) && (
        <p class="mt-4 font-data text-primary">
          {upcomingEvent
            ? `${upNextDay} · ${upcomingEvent.time} · ${upcomingEvent.location}`
            : `${firstService.day} · ${firstService.time} · ${venue}`}
        </p>
      )
    }
    <div
      class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row"
    >
      <Button href={buttonUrl} variant="primary">{buttonText}</Button>
      <Button href={secondaryButtonUrl} variant="secondary">{secondaryButtonText}</Button>
    </div>
  </div>
</section>