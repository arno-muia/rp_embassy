---
import { getSiteConfig } from "../../lib/api";
import { site } from "../../lib/site";

const config = await getSiteConfig();
---

<section class="register-parchment section-padding" data-reveal>
  <div class="mx-auto max-w-4xl px-5 text-center md:px-8" data-reveal>
    <h2 class="font-display text-3xl text-foreground md:text-4xl">
      {config?.welcomeMessage?.title ?? "Our Vision"}
    </h2>
    <blockquote class="mt-8 text-lg leading-relaxed text-foreground md:text-xl" data-reveal>
      &ldquo;{config?.welcomeMessage?.message ?? "Empowering believers to walk in their royal identity and daily Kingdom influence."}&rdquo;
    </blockquote>
    <p class="mt-6 font-semibold text-primary" data-reveal>— Our Vision</p>
  </div>

  <div class="mx-auto mt-16 max-w-4xl px-5 text-center md:px-8" data-reveal>
    <blockquote class="text-lg leading-relaxed text-foreground md:text-xl" data-reveal>
      &ldquo;{config?.welcomeMessage?.message ?? "Empowering believers to walk in their royal identity and daily Kingdom influence."}&rdquo;
    </blockquote>
    <p class="mt-6 font-semibold text-primary" data-reveal>— Our Mission</p>
  </div>
</section>