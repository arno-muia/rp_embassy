---
import { formatDate } from "../../lib/format";
import type { SermonView } from "../../types";

interface Props {
  sermon: SermonView | null;
  ctaText?: string;
  ctaUrl?: string;
}

const { sermon, ctaText, ctaUrl } = Astro.props;
---

{sermon && (
<section class="register-celestial section-padding">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="mb-6 text-center" data-reveal data-reveal-y="24" data-reveal-duration="0.5">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">
        Latest Teaching
      </p>
      <h3 class="font-display mt-2 text-2xl text-foreground md:text-3xl">
        Latest Sermon
      </h3>
    </div>

    <div class="glass-frost card-hover flex flex-col overflow-hidden rounded-2xl md:flex-row" data-reveal data-reveal-y="30" data-reveal-duration="0.6">
      <div class="relative min-h-[400px] w-full md:min-h-[440px] md:w-5/12 lg:w-2/5">
        <a href={`/sermons/${sermon.slug}`} class="block h-full w-full">
          <img
            src={sermon.thumbnail}
            alt={sermon.title}
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
          />
        </a>
      </div>
      <div class="flex flex-1 flex-col px-6 py-10 md:px-10">
        <div>
          <h4 class="font-display text-xl text-foreground md:text-2xl">
            {sermon.title}
          </h4>
          <p class="mt-2 text-sm text-muted-foreground">
            {sermon.speaker} · {formatDate(sermon.date)}
          </p>
          <p class="mt-3 line-clamp-2 text-sm text-muted-foreground">
            {sermon.description}
          </p>
        </div>
        <div class="mt-auto flex flex-col gap-2 pt-8">
          <a
            href={`/sermons/${sermon.slug}`}
            class="text-xs font-semibold uppercase tracking-[0.2em] text-primary transition-colors hover:text-gold-600"
          >
            {ctaText || "Watch Now"} →
          </a>
          <a
            href={ctaUrl || "/sermons"}
            class="text-xs font-semibold uppercase tracking-[0.2em] text-primary transition-colors hover:text-gold-600"
          >
            Browse All Sermons →
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
)}