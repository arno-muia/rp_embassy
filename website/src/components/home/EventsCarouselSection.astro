---
interface Props {
  events: Array<{
    id: string;
    slug: string;
    title: string;
    description: string;
    date: string;
    time?: string;
    location: string;
    image: string;
    category: "service" | "special" | "outreach" | "training";
    registrationRequired: boolean;
    registrationUrl?: string;
    published: boolean;
    status: "upcoming" | "ongoing" | "past";
  }>;
}

const { events = [] }: Props = Astro.props;
---

<section class="register-celestial section-padding">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="mb-10 text-center" data-reveal data-reveal-y="24" data-reveal-duration="0.5">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Mark Your Calendar</p>
      <h3 class="font-display mt-2 text-2xl text-foreground md:text-3xl">Upcoming Events</h3>
    </div>

    {events.length > 0 && (
      <div data-reveal data-reveal-y="30" data-reveal-duration="0.6">
        <script set:html={`const events = ${JSON.stringify(events)};`}></script>
        <!-- Dual Card Grid -->
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2" id="events-grid">
          <!-- Cards injected by client script -->
        </div>

        {events.length > 2 && (
          <div class="mt-6 flex justify-center gap-2" id="events-dots">
            {events.map((e, i) => (
              <button
                type="button"
                aria-label={`Show events ${i + 1}`}
                data-event-dot={i}
                class="event-dot h-2 rounded-full transition-all duration-300"
              />
            ))}
          </div>
        )}
      </div>
    )}
  </div>
</section>

<script>
  let currentIndex = 0;

  function formatEventDate(dateString: string): string {
    return new Date(dateString).toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    });
  }

  function renderSlide(index: number) {
    const grid = document.getElementById('events-grid');
    if (!grid) return;

    // Get current event and next event (for 2-column display)
    const current = events[index];
    const next = events[(index + 1) % events.length];
    
    // Build HTML for up to 2 cards
    let gridHTML = '';
    
    // First card
    if (current) {
      gridHTML += `
        <div class="overflow-hidden rounded-2xl bg-card shadow-lg">
          <a href="/events/${current.slug}" class="block w-full">
            <div class="relative aspect-[16/9] w-full md:aspect-[16/9]">
              <img src="${current.image}" alt="${current.title}" class="h-full w-full object-cover" />
            </div>
          </a>
          <div class="p-5 text-center md:p-6">
            <p class="text-sm font-medium text-primary">${formatEventDate(current.date)}</p>
            <h4 class="mt-2 font-display text-xl text-foreground md:text-2xl">${current.title}</h4>
            <p class="mt-3 line-clamp-2 text-sm text-muted-foreground">${current.description}</p>
            <p class="mt-1 text-xs text-muted-foreground">${current.location}</p>
            <div class="mt-4">
              <a href="/events/${current.slug}" class="text-xs font-semibold uppercase tracking-[0.2em] text-primary transition-colors hover:text-gold-600">
                View Event →
              </a>
            </div>
          </div>
        </div>
      `;
    }
    
    // Second card (only if different from first)
    if (next && next.slug !== current?.slug) {
      gridHTML += `
        <div class="overflow-hidden rounded-2xl bg-card shadow-lg">
          <a href="/events/${next.slug}" class="block w-full">
            <div class="relative aspect-[16/9] w-full md:aspect-[16/9]">
              <img src="${next.image}" alt="${next.title}" class="h-full w-full object-cover" />
            </div>
          </a>
          <div class="p-5 text-center md:p-6">
            <p class="text-sm font-medium text-primary">${formatEventDate(next.date)}</p>
            <h4 class="mt-2 font-display text-xl text-foreground md:text-2xl">${next.title}</h4>
            <p class="mt-3 line-clamp-2 text-sm text-muted-foreground">${next.description}</p>
            <p class="mt-1 text-xs text-muted-foreground">${next.location}</p>
            <div class="mt-4">
              <a href="/events/${next.slug}" class="text-xs font-semibold uppercase tracking-[0.2em] text-primary transition-colors hover:text-gold-600">
                View Event →
              </a>
            </div>
          </div>
        </div>
      `;
    }
    
    grid.innerHTML = gridHTML;
  }

  function updateDots(index: number) {
    document.querySelectorAll('.event-dot').forEach((dot, i) => {
      const btn = dot as HTMLElement;
      if (i === index) {
        btn.classList.add('w-6', 'bg-primary');
        btn.classList.remove('w-2', 'bg-border');
      } else {
        btn.classList.remove('w-6', 'bg-primary');
        btn.classList.add('w-2', 'bg-border');
      }
    });
  }


  function goToEvent(index: number) {
    if (index < 0) index = events.length - 1;
    if (index >= events.length) index = 0;
    if (index !== currentIndex) {
      currentIndex = index;
      renderSlide(currentIndex);
      updateDots(currentIndex);
    }
  }

  function goToNext() {
    const nextIndex = (currentIndex + 2) % events.length;
    goToEvent(nextIndex);
  }

    // Dot clicks
  document.querySelectorAll('[data-event-dot]').forEach((dot) => {
    dot.addEventListener('click', () => {
      goToEvent(parseInt((dot as HTMLElement).dataset.eventDot || '0'));
    });
  });

  // Keyboard arrow keys
  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') goToEvent(currentIndex - 1);
    if (e.key === 'ArrowRight') goToEvent(currentIndex + 1);
  });

  // Autoplay
  if (events.length > 2) {
    setInterval(() => {
      goToNext();
    }, 5000);
  }

  // Initial render
  renderSlide(currentIndex);
  updateDots(currentIndex);
</script>