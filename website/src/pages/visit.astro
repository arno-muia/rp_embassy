---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/shared/PageHero.astro";
import ServiceTimesCarousel from "../components/shared/ServiceTimesCarousel.astro";
import FaqAccordion from "../components/content/FaqAccordion.astro";
import RsvpForm from "../components/forms/RsvpForm.astro";
import Button from "../components/ui/Button.astro";
import {
  getSiteConfig,
  getHomepage,
  getVisit,
  type VisitExpectContent,
  type VisitFaqsContent,
} from "../lib/api";
import { getSections, isEnabled } from "../lib/sections";
import { images, site } from "../lib/site";

const iconMap: Record<string, string> = {
  music: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 text-primary"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>`,
  "book-open": `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 text-primary"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>`,
  users: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 text-primary"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  "trending-up": `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 text-primary"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>`,
};

const [config, homepage, visit, sectionFlags] = await Promise.all([
  getSiteConfig(),
  getHomepage(),
  getVisit(),
  getSections(),
]);
const on = (key: string) => isEnabled(sectionFlags, "visit", key);

/* ---------- B5.7: admin-managed copy with hardcoded fallbacks ---------- */

const hero = visit?.hero ?? {
  title: "You're Welcome Here",
  subtitle:
    "Everything you need to know for your first visit to Royal Priesthood Embassy in Thika, Kenya.",
  scripture: "",
  variant: "warm",
};

const location = visit?.location ?? {
  eyebrow: "Find Us",
  title: "Visit Us in Thika",
  description:
    "We meet at Voice of Grace, behind Spoonzoom in Thika. Look for the hospitality team at the entrance — they will guide you to parking and seating.",
  button_label: "Get Directions",
  button_url: site.address.mapsUrl,
  map_embed_url:
    "https://maps.google.com/maps?q=Voice+of+Grace+Behind+Spoonzoom+Thika+Kenya&output=embed",
  map_title: "Royal Priesthood Embassy location map",
};

const expect: VisitExpectContent = visit?.expect ?? {
  eyebrow: "First Visit?",
  title: "What to Expect",
  items: [
    { id: 0, step: "Arrive", description: "Our hospitality team will greet you at the door and help you find a seat.", icon: "music", sort_order: 0 },
    { id: 1, step: "Worship", description: "Experience authentic, Spirit-led worship that draws you into God's presence.", icon: "book-open", sort_order: 1 },
    { id: 2, step: "Teaching", description: "Receive practical, Bible-based teaching on your royal identity in Christ.", icon: "users", sort_order: 2 },
    { id: 3, step: "Community", description: "Connect with others after service — we'd love to meet you personally.", icon: "trending-up", sort_order: 3 },
  ],
};

const faqs: VisitFaqsContent = visit?.faqs ?? {
  title: "Frequently Asked Questions",
  items: (config?.visitFaqs ?? []).map((f, i) => ({
    id: i + 1,
    question: f.question,
    answer: f.answer,
    sort_order: i,
  })),
};

const rsvp = visit?.rsvp ?? null;

const comingSunday = visit?.comingSunday ?? {
  title: "I Am Coming This Sunday",
  description: "Questions before you visit? Reach out — we're happy to help.",
  button_label: "Contact Us",
  button_url: "#rsvp",
};
---

<Layout
  title="Plan Your Visit"
  description="Plan your visit to Royal Priesthood Embassy in Thika."
>
  {on("page-hero") && (
  <PageHero
    title={hero.title}
    subtitle={hero.subtitle}
    scripture={hero.scripture || undefined}
    register={
      (hero.variant as "celestial" | "parchment" | "warm") || "warm"
    }
  />
  )}

  {
    on("service-times") && homepage?.serviceTimes && homepage.serviceTimes.length > 0 && (
      <section class="register-celestial section-padding">
        <div class="mx-auto max-w-7xl px-5 md:px-8">
        <div class="mb-12 text-center" data-reveal data-reveal-y="24">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">
            Join Us
          </p>
          <h2 class="font-display mt-2 text-3xl text-foreground md:text-4xl">
            Service Times
          </h2>
        </div>
        <ServiceTimesCarousel services={homepage.serviceTimes} />
        </div>
      </section>
    )
  }

  {on("location") && (
  <section class="register-parchment section-padding">
    <div class="mx-auto max-w-7xl px-5 md:px-8">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
        <div>
          <div class="relative aspect-[4/3] overflow-hidden rounded-xl border border-border">
            <img
              src={images.visitWelcome}
              alt="Royal Priesthood Embassy community gathering in Thika"
              class="h-full w-full object-cover"
            />
          </div>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">
            {location.eyebrow}
          </p>
          <h2 class="font-display mt-2 text-3xl text-foreground md:text-4xl">{location.title}</h2>
          <p class="mt-4 text-lg font-semibold text-foreground">
            {site.address.street}
            <br />
            {site.address.city}, {site.address.country}
          </p>
          <p class="mt-4 text-muted-foreground">
            {location.description}
          </p>
          <Button href={location.button_url} variant="primary" external class="mt-6">
            {location.button_label}
          </Button>
        </div>
      </div>
      <div class="mt-10 overflow-hidden rounded-xl border border-primary/20">
        <iframe
          src={location.map_embed_url}
          width="100%"
          height="400"
          style="border:0"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={location.map_title}
          class="aspect-video w-full"
        ></iframe>
      </div>
    </div>
  </section>
  )}

  {on("what-to-expect") && (
  <section class="register-parchment section-padding">
    <div class="mx-auto max-w-7xl px-5 md:px-8">
      <div class="mb-12 text-center" data-reveal data-reveal-y="24">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">{expect.eyebrow}</p>
        <h2 class="font-display mt-2 text-3xl text-foreground md:text-4xl">{expect.title}</h2>
      </div>
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4" data-reveal data-reveal-stagger="0.15" data-reveal-y="30">
        {
          expect.items.map((item) => {
            const iconSvg = iconMap[item.icon] ?? iconMap.users;
            return (
              <article class="card-hover glass-frost rounded-xl p-6 text-center">
                <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full glass-gold">
                  <div set:html={iconSvg} />
                </div>
                <h3 class="font-display text-lg text-foreground">{item.step}</h3>
                <p class="mt-2 text-sm text-muted-foreground">{item.description}</p>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>
  )}

  {
    on("faqs") && faqs.items.length > 0 && (
      <section class="register-parchment section-padding">
        <div class="mx-auto max-w-4xl px-5 md:px-8">
          <div class="text-center" data-reveal data-reveal-y="24">
            <h2 class="font-display text-3xl text-foreground md:text-4xl">
              {faqs.title}
            </h2>
          </div>
          <div class="mt-10">
            <FaqAccordion faqs={faqs.items} />
          </div>
        </div>
      </section>
    )
  }

  {on("rsvp") && (
  <section id="rsvp" class="register-celestial section-padding">
    <div class="mx-auto max-w-xl px-5 md:px-8">
      <RsvpForm
        heading={rsvp?.heading}
        subheading={rsvp?.subheading}
        submitLabel={rsvp?.submit_label}
        successTitle={rsvp?.success_title}
        successMessage={rsvp?.success_message}
      />
    </div>
  </section>
  )}

  {on("coming-sunday") && (
  <section class="section-padding">
    <div
      class="glass-gold mx-auto max-w-2xl rounded-2xl px-5 py-12 text-center md:px-8"
    >
      <h2 class="font-display text-3xl text-foreground md:text-4xl">
        {comingSunday.title}
      </h2>
      <p class="mt-4 text-muted-foreground">
        {comingSunday.description}
      </p>
      <div
        class="mt-8 flex justify-center"
      >
        <Button href={comingSunday.button_url} variant="primary">
          {comingSunday.button_label}
        </Button>
      </div>
    </div>
  </section>
  )}
</Layout>