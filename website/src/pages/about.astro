---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import LeaderCard from "../components/content/LeaderCard.astro";
import { getAbout, getLeaders } from "../lib/api";
import { getSections, isEnabled } from "../lib/sections";
import { site } from "../lib/site";

const about = await getAbout();
const leaders = await getLeaders();
const sectionFlags = await getSections();
const on = (key: string) => isEnabled(sectionFlags, "about", key);

// About section content is admin-managed (B5.5) — every component below is
// edited from the admin's About group and served by /api/about:
//   Admin → About → Welcome, Vision & Mission / Our Values / 2026 Theme
// Fallbacks equal the original copy, so rendering is unchanged when the API
// is unreachable.
const FALLBACK_WELCOME_MESSAGE =
  "When you step into Royal Priesthood Embassy, you are entering a space where the laws of this place are not Kenya’s laws — you are entering the Kingdom. Whether you’re exploring faith for the first time or you’ve walked with Jesus for years, there is a place here for you. We can’t wait to meet you.";

const intro = about?.intro;
const introEyebrow = intro?.eyebrow ?? "1 Peter 2:9";
const introTitle = intro?.title ?? "Welcome to the Embassy";
const visionLabel = intro?.vision_label ?? "our Vision";
const visionText = intro?.vision_text ?? FALLBACK_WELCOME_MESSAGE;
const missionLabel = intro?.mission_label ?? "Our Mission";
const missionText = intro?.mission_text ?? FALLBACK_WELCOME_MESSAGE;

const valuesHeading = about?.values?.heading ?? "Our Values";
const valuesSubtitle =
  about?.values?.subtitle ??
  "The Mantle, Rod, and Sword — Identity, Authority, and Execution";
const values = about?.values?.items ?? [];

const themeEyebrow = about?.theme?.eyebrow ?? "2026 Theme";
const themeTitle = about?.theme?.title ?? site.theme2026.title;
const themeScripture = about?.theme?.scripture ?? site.theme2026.scripture;
const themeScriptureText = about?.theme?.scripture_text ?? site.theme2026.scriptureText;
const themeImage = about?.theme?.image ?? site.theme2026.image;
const themeButtonLabel = about?.theme?.button_label ?? "Join Us";
const themeButtonUrl = about?.theme?.button_url ?? "/visit";

const president = leaders.find((l) => l.role.toLowerCase().includes("president"));
const directors = leaders.filter(
  (l) =>
    l.id !== president?.id &&
    !l.role.toLowerCase().includes("finance") &&
    !l.role.toLowerCase().includes("hospitality"),
);
const otherLeaders = leaders.filter(
  (l) =>
    l.id !== president?.id &&
    (l.role.toLowerCase().includes("finance") ||
      l.role.toLowerCase().includes("hospitality")),
);
---

<Layout
  title="About"
  description="Learn about Royal Priesthood Embassy — our story, beliefs, values, and leadership team in Thika, Kenya."
>
  {on("intro") && (
  <section class="register-parchment section-padding pt-30">
    <div class="mx-auto max-w-7xl px-5 text-center md:px-8">
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-primary">
        {introEyebrow}
      </p>
      <h1 class="font-display text-4xl tracking-tight text-foreground md:text-5xl lg:text-6xl">
        {introTitle}
      </h1>
      <blockquote class="mx-auto mt-8 max-w-3xl text-lg leading-relaxed text-foreground md:text-xl">
        &ldquo;{visionText}&rdquo;
      </blockquote>
      <p class="mt-6 font-semibold text-primary">
        &mdash; {visionLabel}
      </p>
      <blockquote class="mx-auto mt-8 max-w-3xl text-lg leading-relaxed text-foreground md:text-xl">
        &ldquo;{missionText}&rdquo;
      </blockquote>
      <p class="mt-6 font-semibold text-primary">
        &mdash; {missionLabel}
      </p>
    </div>
  </section>
  )}

  {
    on("values") && values.length > 0 && (
      <section class="register-parchment section-padding">
        <div class="mx-auto max-w-7xl px-5 md:px-8">
          <div class="text-center">
            <h2 class="font-display text-3xl text-foreground md:text-4xl">{valuesHeading}</h2>
            <p class="mx-auto mt-4 max-w-2xl text-muted-foreground">
              {valuesSubtitle}
            </p>
          </div>
          <div class="mt-12 grid gap-8 md:grid-cols-3">
            {values.map((value) => (
              <article class="card-hover glass-frost rounded-xl p-8 text-center">
                <h3 class="font-display text-xl text-primary">{value.title}</h3>
                <p class="mt-4 text-sm text-muted-foreground">{value.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {on("leadership") && (
  <section id="leadership" class="register-celestial section-padding">
    <div class="mx-auto max-w-7xl px-5 md:px-8">
      <div class="text-center">
        <h2 class="font-display text-3xl text-foreground md:text-4xl">
          Leadership Team
        </h2>
      </div>

      {
        president && (
          <div class="mt-12">
            <article class="mx-auto max-w-md text-center">
              <LeaderCard leader={president} />
            </article>
          </div>
        )
      }

      {
        directors.length > 0 && (
          <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
            {directors.map((leader) => (
              <LeaderCard leader={leader} />
            ))}
          </div>
        )
      }

      {
        otherLeaders.length > 0 && (
          <div class="mx-auto mt-12 grid max-w-2xl gap-8 sm:grid-cols-2">
            {otherLeaders.map((leader) => (
              <LeaderCard leader={leader} />
            ))}
          </div>
        )
      }
    </div>
  </section>
  )}

  {on("theme-2026") && (
  <section class="register-celestial section-padding">
    <div class="mx-auto max-w-4xl px-5 text-center md:px-8">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">
        {themeEyebrow}
      </p>
      <h2 class="font-display mt-2 text-4xl text-foreground md:text-5xl">
        {themeTitle}
      </h2>
      <p class="mt-4 text-xl text-foreground">
        {themeScripture}
      </p>
      <p class="mt-6 text-lg text-muted-foreground">
        {themeScriptureText}
      </p>
      {
        themeImage && (
          <img
            src={themeImage}
            alt={`${themeTitle} poster`}
            class="mx-auto mt-8 max-w-md rounded-xl border border-primary/20 shadow-lg"
          />
        )
      }
      <div class="mt-8">
        <Button href={themeButtonUrl} variant="gold">{themeButtonLabel}</Button>
      </div>
    </div>
  </section>
  )}
</Layout>