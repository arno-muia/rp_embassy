---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/shared/PageHero.astro";
import Button from "../components/ui/Button.astro";
import { site } from "../lib/site";
---

<Layout
  title="Give"
  description="Give to Royal Priesthood Embassy. M-Pesa Till 8598004."
>
  <PageHero
    title="Give"
    subtitle="Your generosity fuels community outreach, global missions, and the daily work of the Kingdom Embassy."
    register="warm"
    scripture="2 Corinthians 9:7"
  />

  <section class="register-celestial section-padding">
    <div class="mx-auto max-w-4xl px-5 md:px-8 text-center">
      <p class="mt-6 text-lg leading-relaxed text-muted-foreground">
        We give because God first gave — generously, sacrificially, and with joy.
        Your giving is an act of worship and partnership in advancing the Gospel.
        Every contribution, whether large or small, makes a Kingdom impact in
        Thika and beyond.
      </p>
    </div>
  </section>

  <section class="register-parchment section-padding">
    <div class="mx-auto max-w-2xl px-5 md:px-8">
      <div class="glass-gold rounded-2xl p-8 text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">
          M-Pesa Giving
        </p>
        <p
          class="font-data mt-4 text-5xl tracking-wide text-foreground md:text-6xl"
        >
          {site.giving.mpesaTill}
        </p>
        <p class="mt-2 text-muted-foreground">Till Number</p>
        <p class="mt-6 font-semibold text-foreground">
          {site.giving.accountName}
        </p>
        <p class="mt-4 text-sm text-muted-foreground">
          Go to M-Pesa → Lipa na M-Pesa → Buy Goods and Services → Enter Till
          Number
        </p>
        <div class="mt-8">
          <Button href="/contact" variant="primary">Need Help Giving?</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="register-celestial section-padding">
    <div class="mx-auto max-w-4xl px-5 md:px-8">
      <h2 class="font-display text-2xl text-foreground">Where Your Giving Goes</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {
          [
            { title: "Community Programs", pct: "35%", desc: "Local outreach and support in Thika" },
            { title: "Global Missions", pct: "30%", desc: "Church planting and missionary support" },
            { title: "Ministry Operations", pct: "25%", desc: "Facilities, media, and resources" },
            { title: "Benevolence Fund", pct: "10%", desc: "Emergency assistance for families in crisis" },
          ].map((item) => (
            <div class="glass-frost rounded-xl p-6">
              <div class="flex items-center justify-between">
                <h3 class="font-semibold text-foreground">{item.title}</h3>
                <span class="font-data text-2xl text-primary">{item.pct}</span>
              </div>
              <p class="mt-2 text-sm text-muted-foreground">{item.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>