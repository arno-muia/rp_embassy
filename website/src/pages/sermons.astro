---
import Layout from "../layouts/Layout.astro";
import SermonCard from "../components/content/SermonCard.astro";
import { getSermons, getSeries } from "../lib/api";

const sermons = await getSermons();
const series = await getSeries();
---

<Layout title="Sermons" description="Watch and listen to teachings from Royal Priesthood Embassy.">
  <section class="relative overflow-hidden register-celestial -mt-4 pb-0">
    <img
      src="/images/Thumbnail_final.jpg"
      alt="Latest Teaching"
      class="w-full h-96 md:h-[48rem] object-cover"
    />
    <div class="absolute inset-0">
      <div class="relative h-full w-full px-5 md:px-8">
        <!-- "Watch latest sermon" at middle left -->
        <div class="absolute left-12 top-1/2 -translate-y-1/2">
          <p class="font-bold text-8xl text-white ml-8">Latest sermon</p>
        </div>
        
        <!-- Bottom left content: text and link -->
        <div class="absolute bottom-20 left-12 flex flex-col gap-4">
          <div class="ml-8">
            <p class="text-lg text-white">Pst Charles Muchemi</p>
            <h2 class="font-display text-3xl text-charcoal md:text-4xl">Emotional Intelligence</h2>
          </div>
          <a
            href="/sermons"
            class="text-white text-lg font-medium hover:underline ml-8"
          >
            Watch Sermon →
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="register-celestial section-padding">
    <div class="mx-auto max-w-7xl px-5 md:px-8">
      <h2 class="font-display text-2xl text-foreground">Browse by Series</h2>
      <div class="mt-6 flex flex-wrap gap-3">
        {
          series.map((s) => (
            <a
              href={`/series/${s.slug}`}
              class="rounded-full border border-border px-4 py-2 text-sm font-medium text-foreground transition-all hover:border-primary hover:bg-primary/8 hover:text-primary"
            >
              {s.title}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="register-parchment section-padding">
    <div class="mx-auto max-w-7xl px-5 md:px-8">
      <h2 class="font-display text-2xl text-foreground">All Sermons</h2>
      {
        sermons.length > 0 ? (
          <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {sermons.map((sermon) => (
              <SermonCard sermon={sermon} />
            ))}
          </div>
        ) : (
          <p class="mt-6 text-muted-foreground">No sermons available yet.</p>
        )
      }
    </div>
  </section>
</Layout>