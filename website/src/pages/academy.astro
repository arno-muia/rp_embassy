---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/shared/PageHero.astro";
import AcademyModuleCard from "../components/content/AcademyModuleCard.astro";
import Button from "../components/ui/Button.astro";
import { getAcademyModules } from "../lib/api";
import { getCurrentUser, hasAcademyAccess } from "../lib/auth";
import { images, site } from "../lib/site";

// A1.3: The middleware has already checked for the session cookie.
// Here we verify authentication + AcademyAccess via API.
//
// A1: Forward the browser's Cookie header to the Django API.  This runs
// server-side during SSR; Node.js fetch does not attach browser cookies
// automatically, so without this the page loops back to /login.
const cookieHeader = Astro.request.headers.get("cookie") || undefined;
const user = await getCurrentUser(cookieHeader);

let academyState: "authorized" | "denied" | "unauthenticated" = "unauthenticated";
let modules: import("../types").AcademyModuleView[] = [];

if (!user) {
  // Session cookie was present but the session is invalid/expired.
  // Redirect to login.
  return Astro.redirect("/login?redirect=/academy");
}

// User is authenticated — check AcademyAccess
const hasAccess = await hasAcademyAccess(cookieHeader);
if (hasAccess) {
  academyState = "authorized";
  modules = await getAcademyModules(cookieHeader);
} else {
  academyState = "denied";
}
---

<Layout
  title="Kingdom Formation Academy"
  description="Discover Kingdom Formation — the discipleship system of Royal Priesthood Embassy."
>
  <PageHero
    title="Kingdom Formation"
    subtitle="Discover Your True Identity — the discipleship system that equips ambassadors for daily Kingdom influence."
    register="parchment"
    scripture="Romans 8:29"
  />

  <section class="register-celestial section-padding">
    <div class="mx-auto max-w-5xl px-5 md:px-8">
      <div class="relative mb-10 aspect-[21/9] overflow-hidden rounded-xl border border-border">
        <img
          src={images.academyHero}
          alt="Kingdom Formation — Tuesday discipleship gathering"
          class="h-full w-full object-cover"
        />
      </div>
      <h2 class="font-display text-3xl text-foreground">What is Kingdom Formation?</h2>
      <div class="mt-6 space-y-4 text-lg leading-relaxed text-muted-foreground">
        <p>
          Kingdom Formation is the discipleship engine of Royal Priesthood
          Embassy. It is not a program you complete — it is a journey of
          transformation where believers discover their true identity as sons of
          God and learn to walk in daily Kingdom influence.
        </p>
        <p>
          Every Tuesday at 8:30 PM, we gather online for Blueprint Tuesdays —
          deep teaching and Holy Communion. The Academy extends this formation
          with structured modules you can study at your own pace.
        </p>
      </div>
    </div>
  </section>

  {academyState === "authorized" && (
    <section class="register-parchment section-padding">
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <div class="text-center">
          <h2 class="font-display text-3xl text-foreground">Module Catalog</h2>
          <p class="mt-2 text-sm text-muted-foreground">
            Welcome back, {user?.name ?? "Member"}
          </p>
        </div>
        {
          modules.length > 0 ? (
            <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
              {modules.map((mod) => (
                <AcademyModuleCard module={mod} />
              ))}
            </div>
          ) : (
            <p class="mt-6 text-center text-muted-foreground">
              Module catalog is being prepared. Check back soon.
            </p>
          )
        }
      </div>
    </section>
  )}

  {academyState === "denied" && (
    <section class="section-padding">
      <div class="mx-auto max-w-2xl rounded-2xl border border-rp-danger/20 bg-rp-danger/5 px-5 py-12 text-center md:px-8">
        <h2 class="font-display text-3xl text-foreground">Access Required</h2>
        <p class="mt-4 text-muted-foreground">
          You are signed in as <strong>{user?.email}</strong>, but your account
          does not have Academy access. Please contact your church administrator
          to request Academy access.
        </p>
        <div class="mt-8">
          <Button href="/" variant="primary">
            Back to Website
          </Button>
        </div>
      </div>
    </section>
  )}

  {academyState === "authorized" && (
    <section class="section-padding">
      <div
        class="glass-gold mx-auto max-w-2xl rounded-2xl px-5 py-12 text-center md:px-8"
      >
        <h2 class="font-display text-3xl text-foreground md:text-4xl">
          Begin Your Journey
        </h2>
        <p class="mt-4 text-muted-foreground">
          Enroll in Kingdom Formation Academy to access all modules, track your
          progress, and join a community of learners.
        </p>
        <div class="mt-8">
          <Button href={site.academyUrl} variant="primary" external>
            Enroll at Academy
          </Button>
        </div>
      </div>
    </section>
  )}
</Layout>