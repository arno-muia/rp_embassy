---
import AcademyLayout from "../layouts/AcademyLayout.astro";
import Button from "../components/ui/Button.astro";
import { getCurrentUser, hasAcademyAccess } from "../lib/auth";
import { images, site } from "../lib/site";

// A1.3: The middleware has already checked for the session cookie.
// Here we verify authentication + AcademyAccess via API.
//
// A1: Forward the browser's Cookie header to the Django API.  This runs
// server-side during SSR; Node.js fetch does not attach browser cookies
// automatically, so without this the page loops back to /login.
const cookieHeader = Astro.request.headers.get("cookie") || undefined;
const user = await getCurrentUser(cookieHeader);

let academyState: "authorized" | "denied" | "unauthenticated" = "unauthenticated";

if (!user) {
  // Session cookie was present but the session is invalid/expired.
  // Redirect to login.
  return Astro.redirect("/login?redirect=/academy");
}

// User is authenticated — check AcademyAccess
const hasAccess = await hasAcademyAccess(cookieHeader);
if (hasAccess) {
  academyState = "authorized";
} else {
  academyState = "denied";
}

/* D1: Dashboard placeholder data - structured as arrays/objects so they
 *      can be swapped for real API data later without touching the markup. */
const dashboardData = {
  userName: user?.name ?? "Member",
  overallProgress: 51,
  // KPI placeholders
  kpis: [
    { label: "Lessons Completed", value: 8 },
    { label: "Quizzes Passed", value: 5 },
    { label: "Active Modules", value: 3 },
    { label: "Certificates", value: 1 },
  ],
  program: {
    title: "Kingdom Formation",
    instructor: "Pastor Charles Muchemi",
    image: images.hero,
    progress: 65,
    lessonsCount: 12,
    duration: "4 weeks",
  },
  learningPath: {
    previous: {
      title: "Understanding Your Identity in Christ",
      description:
        "Discover your true identity as a son of God and co-heir with Christ.",
    },
    next: {
      title: "Walking in Daily Kingdom Authority",
      description:
        "Learn to exercise spiritual authority in your everyday circumstances.",
    },
  },
  // Active modules placeholder data
  activeModules: [
    {
      id: "am1",
      title: "Foundations of Sonship",
      description: "Explore the core principles of your identity in Christ.",
      difficulty: "Beginner",
      lessonsCount: 5,
      progress: 40,
    },
    {
      id: "am2",
      title: "Priesthood Nature",
      description: "Understand the role of priesthood in the Kingdom.",
      difficulty: "Intermediate",
      lessonsCount: 8,
      progress: 20,
    },
  ],
  // Completed modules placeholder data
  completedModules: [
    {
      id: "cm1",
      title: "Introduction to Kingdom Formation",
      completedDate: "2024-07-15",
    },
    {
      id: "cm2",
      title: "Spiritual Authority Basics",
      completedDate: "2024-08-01",
    },
  ],
  // All modules (kept for reference)
  modules: [
    { id: "m1", title: "Foundation of Sonship", instructor: "Pastor Charles Muchemi", progress: 100 },
    { id: "m2", title: "The Nature of Priesthood", instructor: "Pastor Mark Mwangi", progress: 75 },
    { id: "m3", title: "Blueprint Tuesdays", instructor: "Pastor Charles Muchemi", progress: 60 },
    { id: "m4", title: "Spiritual Authority", instructor: "Pastor Salome Waruguru", progress: 40 },
    { id: "m5", title: "Kingdom Influence", instructor: "Pastor Mercy Zawadi", progress: 25 },
    { id: "m6", title: "Community & Fellowship", instructor: "Pastor Lucy Auma", progress: 0 },
  ],
};
---

<AcademyLayout
  title="Kingdom Formation Academy"
  description="Discover Kingdom Formation — the discipleship system of Royal Priesthood Embassy."
>
  {academyState === "authorized" && (
    <>
      {/* 1. Welcome / Progress Section */}
      <section class="register-parchment section-padding">
        <div class="mx-auto max-w-7xl px-5 md:px-8">
          <div class="glass-frost rounded-2xl p-6 md:p-8">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between md:gap-6">
              <div>
                <p class="text-sm font-semibold text-muted-foreground">
                  Hello, {dashboardData.userName}!
                </p>
                <h2 class="font-display text-2xl text-foreground md:text-3xl">
                  Your Overall Progress
                </h2>
              </div>
              <p class="mt-2 text-sm font-semibold text-primary md:mt-0 md:text-right">
                {dashboardData.overallProgress}% Completed
              </p>
            </div>
            <div class="mt-6">
              <div class="h-3 w-full overflow-hidden rounded-full bg-muted">
                <div
                  class="h-full rounded-full bg-primary transition-all duration-500 ease-out"
                  style={`width: ${dashboardData.overallProgress}%`}
                ></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* 2. My Discipleship Program */}
      <section class="register-parchment section-padding">
        <div class="mx-auto max-w-7xl px-5 md:px-8">
          <h2 class="font-display text-3xl text-foreground">
            My Discipleship Program
          </h2>
          <div class="mt-8">
            <div class="glass-gold card-hover rounded-2xl overflow-hidden md:flex">
              <div class="aspect-square md:aspect-auto md:w-80 shrink-0">
                <img
                  src={dashboardData.program.image}
                  alt={dashboardData.program.title}
                  class="h-full w-full object-cover"
                />
              </div>
              <div class="p-6 md:p-8 md:pl-8">
                <h3 class="font-display text-2xl text-foreground">
                  {dashboardData.program.title}
                </h3>
                <p class="text-sm font-semibold text-primary">
                  Instructor: {dashboardData.program.instructor}
                </p>
                <p class="mt-3 text-sm text-muted-foreground">
                  {dashboardData.program.lessonsCount} lessons · {dashboardData.program.duration}
                </p>
                <div class="mt-4">
                  <div class="flex items-center justify-between text-sm">
                    <span class="text-muted-foreground">Progress</span>
                    <span class="font-semibold text-primary">
                      {dashboardData.program.progress}% Completed
                    </span>
                  </div>
                  <div class="mt-2 h-2.5 w-full overflow-hidden rounded-full bg-muted">
                    <div
                      class="h-full rounded-full bg-primary transition-all duration-500 ease-out"
                      style={`width: ${dashboardData.program.progress}%`}
                    ></div>
                  </div>
                </div>
                <div class="mt-6">
                  <Button href={site.academyUrl} variant="primary" external>
                    Continue Journey
                  </Button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      {/* 3. Continue Learning */}
      <section class="register-parchment section-padding">
        <div class="mx-auto max-w-7xl px-5 md:px-8">
          <h2 class="font-display text-3xl text-foreground">
            Continue Learning
          </h2>
          <div class="mt-8 grid gap-6 md:grid-cols-2">
            <div class="glass-frost card-hover rounded-xl p-6">
              <div class="mb-4 flex items-center gap-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary/10">
                  <svg
                    class="h-5 w-5 text-primary"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 19l-7-7 7-7"
                    />
                  </svg>
                </div>
                <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                  Previous Topic
                </span>
              </div>
              <h3 class="font-display text-xl text-foreground">
                {dashboardData.learningPath.previous.title}
              </h3>
              <p class="mt-2 text-sm text-muted-foreground">
                {dashboardData.learningPath.previous.description}
              </p>
              <div class="mt-4">
                <Button variant="outline" href="#previous-topic">
                  Reflect
                </Button>
              </div>
            </div>
            <div class="glass-frost card-hover rounded-xl p-6">
              <div class="mb-4 flex items-center justify-end gap-3">
                <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                  Next Topic
                </span>
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary/10">
                  <svg
                    class="h-5 w-5 text-primary"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"
                    />
                  </svg>
                </div>
              </div>
              <h3 class="font-display text-xl text-foreground">
                {dashboardData.learningPath.next.title}
              </h3>
              <p class="mt-2 text-sm text-muted-foreground">
                {dashboardData.learningPath.next.description}
              </p>
              <div class="mt-4">
                <Button variant="primary" href="#next-topic">
                  Begin
                </Button>
              </div>
            </div>
          </div>
        </div>
      </section>
      {/* 4. All Modules */}
      <section class="register-parchment section-padding">
        <div class="mx-auto max-w-7xl px-5 md:px-8">
          <h2 class="font-display text-3xl text-foreground">
            All Modules
          </h2>
          <div class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="relative flex-1">
              <label for="module-search" class="sr-only">Search modules</label>
              <input
                id="module-search"
                type="text"
                placeholder="Search modules..."
                class="w-full rounded-md border border-border bg-background px-4 py-2.5 pl-10 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-ring"
              />
              <svg
                class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 1116.65 16.65z"
                />
              </svg>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-sm text-muted-foreground">Filter:</span>
              <select
                class="rounded-md border border-border bg-background px-3 py-1.5 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-ring"
              >
                <option>All</option>
                <option>In Progress</option>
                <option>Not Started</option>
                <option>Completed</option>
              </select>
            </div>
          </div>
          <div class="mt-6 overflow-x-auto rounded-xl border border-border">
            <table class="w-full min-w-[640px] border-collapse">
              <thead>
                <tr class="bg-muted/50">
                  <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                    Program Title
                  </th>
                  <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                    Instructor
                  </th>
                  <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                    Progress
                  </th>
                  <th class="px-4 py-3 text-center text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                    Action
                  </th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                {dashboardData.modules.map((mod) => (
                  <tr class="bg-background">
                    <td class="px-4 py-4">
                      <span class="font-medium text-foreground">{mod.title}</span>
                    </td>
                    <td class="px-4 py-4 text-sm text-muted-foreground">
                      {mod.instructor}
                    </td>
                    <td class="px-4 py-4">
                      <div class="flex items-center gap-3">
                        <div class="h-2 flex-1 overflow-hidden rounded-full bg-muted">
                          <div
                            class="h-full rounded-full bg-primary transition-all duration-500 ease-out"
                            style={`width: ${mod.progress}%`}
                          ></div>
                        </div>
                        <span class="w-12 text-right text-sm font-semibold text-muted-foreground">
                          {mod.progress}%
                        </span>
                      </div>
                    </td>
                    <td class="px-4 py-4 text-center">
                      <Button
                        variant="small"
                        class="px-3 py-1.5 text-xs"
                        href={`#module-${mod.id}`}
                      >
                        View Module
                      </Button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>
    </>
  )}

  {academyState === "denied" && (
    <section class="section-padding">
      <div class="mx-auto max-w-2xl rounded-2xl border border-rp-danger/20 bg-rp-danger/5 px-5 py-12 text-center md:px-8">
        <h2 class="font-display text-3xl text-foreground">Access Required</h2>
        <p class="mt-4 text-muted-foreground">
          You are signed in as <strong>{user?.email}</strong>, but your account
          does not have Academy access. Please contact your church administrator
          to request Academy access.
        </p>
        <div class="mt-8">
          <Button href="/" variant="primary">
            Back to Website
          </Button>
        </div>
      </div>
    </section>
  )}

  {academyState === "authorized" && (
    <section class="section-padding">
      <div
        class="glass-gold mx-auto max-w-2xl rounded-2xl px-5 py-12 text-center md:px-8"
      >
        <h2 class="font-display text-3xl text-foreground md:text-4xl">
          Begin Your Journey
        </h2>
        <p class="mt-4 text-muted-foreground">
          Enroll in Kingdom Formation Academy to access all modules, track your
          progress, and join a community of learners.
        </p>
        <div class="mt-8">
          <Button href={site.academyUrl} variant="primary" external>
            Enroll at Academy
          </Button>
        </div>
      </div>
    </section>
  )}
</AcademyLayout>