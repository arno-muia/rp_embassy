---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/shared/PageHero.astro";
import SermonCard from "../../components/content/SermonCard.astro";
import Button from "../../components/ui/Button.astro";

import { getSermonBySlug, getRelatedSermons, getSermons, getSermonsPage } from "../../lib/api";
import type { SermonDetailContent, SermonsRelatedContent } from "../../lib/api";
import { formatDate } from "../../lib/format";


export async function getStaticPaths() {
  try {
    const sermons = await getSermons();
    return sermons.map((s) => ({ params: { slug: s.slug } }));
  } catch {
    return [];
  }
}

const { slug } = Astro.params;
const sermon = slug ? await getSermonBySlug(slug) : undefined;

if (!sermon) return Astro.redirect("/sermons");

const [related, sermonsPage] = await Promise.all([
  getRelatedSermons(sermon),
  getSermonsPage(),
]);

// Fallbacks = the original hardcoded copy when the API is unreachable.
const detailFallback: SermonDetailContent = {
  video_note: "Watch this teaching on our YouTube channel",
  watch_button_label: "Watch on YouTube",
  secondary_button_label: "Kingdom Formation",
  secondary_button_url: "/academy",
};
const detail = sermonsPage?.detail ?? detailFallback;

const relatedFallback: SermonsRelatedContent = { heading: "Related Sermons" };
const relatedHeading = sermonsPage?.related ?? relatedFallback;
---

<Layout title={sermon.title} description={sermon.description}>
  <PageHero
    title={sermon.title}
    subtitle={`${sermon.speaker} · ${formatDate(sermon.date)} · ${sermon.series}`}
    register="warm"
    scripture={sermon.scripture}
  />

  <section class="register-celestial section-padding">
    <div class="mx-auto max-w-4xl px-5 md:px-8">
      <div
        class="relative aspect-video overflow-hidden rounded-xl border border-primary/20 bg-obsidian-900"
      >
        <img
          src={sermon.thumbnail}
          alt={sermon.title}
          class="h-full w-full object-cover opacity-60"
        />
        <div
          class="absolute inset-0 flex flex-col items-center justify-center gap-4"
        >
          <p class="text-center text-ivory-100/90">
            {detail.video_note}
          </p>
          <Button href={sermon.videoUrl} variant="gold" external>
            {detail.watch_button_label}
          </Button>
        </div>
      </div>
      <p class="mt-8 text-lg leading-relaxed text-muted-foreground">
        {sermon.description}
      </p>
      {
        sermon.scripture && (
          <p class="mt-4 text-lg text-primary">{sermon.scripture}</p>
        )
      }
      <div class="mt-6 flex flex-wrap gap-4">
        <Button href={sermon.videoUrl} variant="primary" external>
          {detail.watch_button_label}
        </Button>
        <Button href={detail.secondary_button_url} variant="secondary">{detail.secondary_button_label}</Button>
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="register-parchment section-padding">
        <div class="mx-auto max-w-7xl px-5 md:px-8">
          <h2 class="font-display text-2xl text-foreground">{relatedHeading.heading}</h2>
          <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((s) => (
              <SermonCard sermon={s} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Layout>