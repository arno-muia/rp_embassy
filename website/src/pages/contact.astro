---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/shared/PageHero.astro";
import ContactForm from "../components/forms/ContactForm.astro";
import { site } from "../lib/site";
---

<Layout
  title="Contact"
  description="Contact Royal Priesthood Embassy in Thika, Kenya."
>
  <PageHero
    title="Contact Us"
    subtitle="We'd love to hear from you. Reach out with questions, prayer requests, or to plan your visit."
    register="parchment"
  />
  <section class="register-celestial section-padding">
    <div class="mx-auto max-w-4xl px-5 md:px-8">
      <div class="grid gap-12 lg:grid-cols-2">
        <div class="space-y-8">
          <div>
            <h2 class="font-display text-lg text-primary">Email</h2>
            <a
              href={`mailto:${site.contact.email}`}
              class="mt-2 block text-muted-foreground transition-colors hover:text-primary"
            >
              {site.contact.email}
            </a>
          </div>
          <div>
            <h2 class="font-display text-lg text-primary">Location</h2>
            <p class="mt-2 text-muted-foreground">
              {site.address.street}
              <br />
              {site.address.city}, {site.address.country}
            </p>
            <a
              href={site.address.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-2 inline-block text-sm font-semibold text-primary hover:text-gold-600"
            >
              Get Directions →
            </a>
          </div>
          <div>
            <h2 class="font-display text-lg text-primary">Social Media</h2>
            <ul class="mt-2 space-y-2">
              {
                Object.entries(site.social).map(([network, href]) => (
                  <li>
                    <a
                      href={href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="capitalize text-muted-foreground transition-colors hover:text-primary"
                    >
                      {network}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
        <div>
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</Layout>